# ============================================================
# 链接音频库 - 环境变量示例
# 复制为 .env 后按需修改：
#   cp .env.example .env
# ============================================================

# ---------- 存储 ----------
MUSIC_DIR=./music
DB_PATH=./data/music.db

# ---------- 下载 / 并发 / 超时 ----------
# 单个文件最大体积（MB），同时限制 FFmpeg 输出大小
MAX_DOWNLOAD_MB=500
# 同时执行的提取任务数（单进程内有效）
MAX_CONCURRENT_EXTRACTIONS=2
# 并发已满时，请求最多排队多久（秒）
QUEUE_TIMEOUT_SECONDS=45
# 请求抖音 HTML 页面的超时（秒）
PAGE_TIMEOUT_SECONDS=20
# 下载音频/视频的超时（秒）
DOWNLOAD_TIMEOUT_SECONDS=300
# FFmpeg 转码的超时（秒）
FFMPEG_TIMEOUT_SECONDS=600
# 解析页面时的最大 HTML 体积（字节）
MAX_PAGE_BYTES=8388608

# ---------- 网络 / 安全 ----------
# 对抖音页面和媒体直链做 DNS 公网地址校验，防止 SSRF。
# 仅在特殊的代理/DNS 环境下才考虑关闭；关闭后仍有抖音域名白名单。
SSRF_DNS_CHECK=true

# 抖音 provider 请求使用的移动端 UA（一般无需修改）
# USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Mobile/15E148 Safari/604.1
DOUYIN_REFERER=https://www.douyin.com/

# ---------- FFmpeg ----------
# 如果 ffmpeg/ffprobe 不在 PATH 中，可填写绝对路径
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- Docker Compose 专用 ----------
APP_PORT=8001
PUID=1000
PGID=1000
TZ=Asia/Shanghai
